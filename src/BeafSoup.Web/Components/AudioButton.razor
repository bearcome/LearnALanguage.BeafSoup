@using BeafSoup.Web.Services
@inject AudioPlaybackService Audio

<span class="audio-control">
    <button class="audio-button @(Compact ? "is-compact" : "")"
            disabled="@(AudioUrl is null)"
            title="@(AudioUrl is null ? "音频尚未生成" : $"播放{Label}")"
            aria-label="@(AudioUrl is null ? $"{Label}音频尚未生成" : $"播放{Label}")"
            @onclick="PlayAsync">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9v6h4l5 4V5L8 9H4zm12.5 3a3.5 3.5 0 0 0-1.5-2.87v5.74A3.5 3.5 0 0 0 16.5 12zm-1.5-7.7v2.06a6 6 0 0 1 0 11.28v2.06a8 8 0 0 0 0-15.4z"/></svg>
        @if (!Compact) { <span>@(AudioUrl is null ? "音频待生成" : Label)</span> }
    </button>
    @if (_failed) { <span class="audio-error" role="alert">播放失败，请稍后重试</span> }
</span>

@code {
    [Parameter] public string? AudioUrl { get; set; }
    [Parameter] public string Label { get; set; } = "音频";
    [Parameter] public bool Compact { get; set; }
    private bool _failed;

    private async Task PlayAsync()
    {
        if (AudioUrl is null) return;
        _failed = !await Audio.PlayAsync(AudioUrl);
    }
}
