@page "/"
@page "/courses"
@using BeafSoup.Contracts
@using BeafSoup.Web.Services
@inject LearningApiClient Api
@inject GuestProgressStore ProgressStore

<PageTitle>我的德语课程 · BeafSoup</PageTitle>

@if (_error is not null)
{
    <div class="state-card error-state">
        <span class="eyebrow">连接失败</span>
        <h1>课程暂时无法加载</h1>
        <p>@_error</p>
        <button class="primary-button" @onclick="LoadAsync">重新加载</button>
    </div>
}
else if (_course is null)
{
    <div class="loading-state"><span class="loading-dot"></span>正在打开德语学习手册…</div>
}
else
{
    @if (ProgressStore.StorageWarning is not null) { <p class="inline-error" role="alert">@ProgressStore.StorageWarning</p> }
    <section class="course-hero">
        <div class="hero-copy">
            <span class="eyebrow">DEUTSCH · NULL START</span>
            <h1>从第一句德语，<br />走进真实日常。</h1>
            <p>@_course.Description</p>
            <div class="hero-actions">
                <a class="primary-button" href="lessons/@_course.Lessons[0].Id">开始第 1 课 <span aria-hidden="true">↗</span></a>
                <a class="text-link" href="practice">直接进入完整题库</a>
            </div>
        </div>
        <div class="hero-specimen" aria-label="课程示例">
            <span class="specimen-label">今天先学会这一句</span>
            <strong lang="de">Ich heiße Anna.</strong>
            <span>我叫安娜。</span>
            <div class="specimen-rule"><i></i><i></i><i></i><i></i><i></i></div>
            <small>听 · 看 · 理解 · 练习</small>
        </div>
    </section>

    <section class="course-metrics" aria-label="课程统计">
        <div><strong>@_course.Lessons.Count</strong><span>个递进课时</span></div>
        <div><strong>@_course.Lessons.Sum(lesson => lesson.VocabularyCount)</strong><span>个核心词汇</span></div>
        <div><strong>@_course.Lessons.Sum(lesson => lesson.SentenceCount)</strong><span>个实用句子</span></div>
        <div><strong>@_course.Lessons.Sum(lesson => lesson.QuestionCount)</strong><span>道单选练习</span></div>
    </section>

    <section class="lesson-section">
        <div class="section-heading">
            <div><span class="eyebrow">DIALOGE</span><h2>场景对话</h2></div>
            <span class="section-note">多音色顺序播放 · 可留出跟读时间</span>
        </div>
        <div class="dialogue-grid">
            @foreach (var dialogue in _course.Dialogues)
            {
                <a class="dialogue-card" href="dialogues/@dialogue.Id">
                    <div class="dialogue-card-top">
                        <span class="lesson-number">@dialogue.Order.ToString("00")</span>
                        <span class="lesson-status">@dialogue.TurnCount 句</span>
                    </div>
                    <h3>@dialogue.Title</h3>
                    <p>@dialogue.Scenario</p>
                    <div class="dialogue-card-roles">
                        @foreach (var speaker in dialogue.Speakers)
                        {
                            <span class="speaker-chip is-@speaker.Color" lang="de">@speaker.Name<small>@speaker.Role</small></span>
                        }
                    </div>
                </a>
            }
        </div>
    </section>

    <section class="lesson-section">
        <div class="section-heading">
            <div><span class="eyebrow">LEARNING PATH</span><h2>你的学习路径</h2></div>
            <span class="local-progress">@_progress.CompletedLessons.Count / @_course.Lessons.Count 课已完成 · @(ProgressStore.SyncedToServer ? "进度已同步到服务器" : "进度保存在本机")</span>
        </div>
        <div class="lesson-grid">
            @foreach (var lesson in _course.Lessons)
            {
                var complete = _progress.CompletedLessons.Contains(lesson.Id);
                <a class="lesson-card @(complete ? "is-complete" : "")" href="lessons/@lesson.Id">
                    <div class="lesson-card-top">
                        <span class="lesson-number">@lesson.Order.ToString("00")</span>
                        <span class="lesson-status">@(complete ? "已完成 ✓" : $"{lesson.QuestionCount} 道练习")</span>
                    </div>
                    <h3>@lesson.Title</h3>
                    <p>@lesson.Summary</p>
                    <div class="lesson-card-bottom">
                        <span>@lesson.VocabularyCount 词 · @lesson.SentenceCount 句</span>
                        <span class="round-arrow" aria-hidden="true">→</span>
                    </div>
                </a>
            }
        </div>
    </section>
}

@code {
    private CourseDetailDto? _course;
    private GuestProgressState _progress = new();
    private string? _error;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _error = null;
        _course = null;
        try
        {
            var summary = await Api.GetCourseSummaryAsync();
            if (summary is null) throw new InvalidOperationException("课程接口返回了空内容。");
            _course = await Api.GetCourseAsync(summary.Id);
            _progress = await ProgressStore.LoadAsync(summary.Id);
        }
        catch (Exception exception)
        {
            _error = $"请确认 API 已启动，然后重试。{exception.Message}";
        }
    }
}
